#!/bin/bash
set -euo pipefail

frequency="${1:-}"

if ! awk -v f="$frequency" 'BEGIN { exit !(f ~ /^[0-9]+(\.[0-9]+)?$/ && f >= 87.5 && f <= 108.0) }'; then
  echo "Invalid frequency: $frequency" >&2
  exit 2
fi

printf '%s\n' "$frequency" >/tmp/radio-frequency

/usr/bin/radio-stop-stream
sleep 0.2

if ! command -v fm_transmitter >/dev/null 2>&1; then
  echo "fm_transmitter not found" >&2
  exit 1
fi

device=""
for _ in $(seq 1 20); do
  while read -r _ mac _name; do
    if bluetoothctl info "$mac" 2>/dev/null | grep -q "Connected: yes"; then
      device="$mac"
      break
    fi
  done <<EOF
$(bluetoothctl devices 2>/dev/null)
EOF
  [ -n "$device" ] && break
  sleep 1
done

if [ -z "$device" ]; then
  echo "No connected Bluetooth audio device found" >&2
  exit 3
fi

(
  exec </dev/null
  arecord -D "bluealsa:DEV=$device,PROFILE=a2dp" -f S16_LE -r 22050 -c 1 - |
    fm_transmitter -f "$frequency" -
) >/var/log/radio-stream.log 2>&1 &

echo "FM stream restarted at ${frequency} MHz from ${device}"
