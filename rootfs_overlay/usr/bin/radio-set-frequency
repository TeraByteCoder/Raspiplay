#!/bin/bash
set -euo pipefail

frequency="${1:-}"

if ! awk -v f="$frequency" 'BEGIN { exit !(f ~ /^[0-9]+(\.[0-9]+)?$/ && f >= 87.5 && f <= 108.0) }'; then
  echo "Invalid frequency: $frequency" >&2
  exit 2
fi

printf '%s\n' "$frequency" >/tmp/radio-frequency

/usr/bin/radio-stop-stream
sleep 0.2

if ! command -v fm_transmitter >/dev/null 2>&1; then
  echo "fm_transmitter not found" >&2
  exit 1
fi

if ! command -v bluealsa-cli >/dev/null 2>&1; then
  echo "bluealsa-cli not found" >&2
  exit 1
fi

device=""
for _ in $(seq 1 20); do
  while read -r _ mac _name; do
    if bluetoothctl info "$mac" 2>/dev/null | grep -q "Connected: yes"; then
      device="$mac"
      break
    fi
  done <<EOF
$(bluetoothctl devices 2>/dev/null)
EOF
  [ -n "$device" ] && break
  sleep 1
done

if [ -z "$device" ]; then
  /usr/bin/radio-start-silence "$frequency"
  echo "No connected Bluetooth audio device found; silence carrier active at ${frequency} MHz"
  exit 0
fi

device_path="dev_${device//:/_}"
pcm_path=""
for _ in $(seq 1 10); do
  pcm_path="$(bluealsa-cli list-pcms 2>/dev/null | grep "/$device_path/" | grep "/a2dpsnk/source" | head -n 1 || true)"
  [ -n "$pcm_path" ] && break
  sleep 1
done

if [ -z "$pcm_path" ]; then
  /usr/bin/radio-start-silence "$frequency"
  echo "No BlueALSA A2DP PCM found for ${device}; silence carrier active at ${frequency} MHz"
  exit 0
fi

write_wav_stream_header() {
  printf 'RIFF'
  printf '\377\377\377\177'
  printf 'WAVEfmt '
  printf '\020\000\000\000'
  printf '\001\000'
  printf '\001\000'
  printf '\104\254\000\000'
  printf '\210\130\001\000'
  printf '\002\000'
  printf '\020\000'
  printf 'data'
  printf '\377\377\377\177'
}

(
  exec </dev/null
  set +e
  {
    write_wav_stream_header
    bluealsa-cli open "$pcm_path"
  } | fm_transmitter -f "$frequency" -
  status=$?
  /usr/bin/radio-start-silence "$frequency" >/var/log/radio-silence-fallback.log 2>&1
  exit "$status"
) >/var/log/radio-stream.log 2>&1 &

echo "FM stream restarted at ${frequency} MHz from ${device}"
