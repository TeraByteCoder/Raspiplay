#!/bin/sh

bt_stream_active() {
  pidof bluealsa-cli >/dev/null 2>&1 &&
    pidof radio-pcm-half >/dev/null 2>&1 &&
    pidof fm_transmitter >/dev/null 2>&1
}

stop_broken_stream() {
  killall radio-set-frequency 2>/dev/null || true
  killall bluealsa-cli 2>/dev/null || true
  killall radio-pcm-half 2>/dev/null || true
  killall fm_transmitter 2>/dev/null || true
}

while true; do
  frequency="$(cat /tmp/radio-frequency 2>/dev/null || echo 108.0)"
  connected=""

  bluetoothctl devices 2>/dev/null | while read -r _ mac _name; do
    case "$mac" in
      [0-9A-Fa-f][0-9A-Fa-f]:[0-9A-Fa-f][0-9A-Fa-f]:[0-9A-Fa-f][0-9A-Fa-f]:[0-9A-Fa-f][0-9A-Fa-f]:[0-9A-Fa-f][0-9A-Fa-f]:[0-9A-Fa-f][0-9A-Fa-f])
        bluetoothctl trust "$mac" >/dev/null 2>&1 || true
        if bluetoothctl info "$mac" 2>/dev/null | grep -q "Connected: yes"; then
          echo "$mac" >/tmp/radio-connected-device
        fi
        ;;
    esac
  done

  if [ -s /tmp/radio-connected-device ]; then
    connected="$(cat /tmp/radio-connected-device)"
    rm -f /tmp/radio-connected-device
  fi

  if [ -n "$connected" ]; then
    if ! bt_stream_active; then
      stop_broken_stream
      sleep 1
      /usr/bin/radio-set-frequency "$frequency" >/var/log/radio-auto-stream.log 2>&1 || true
    fi
  else
    if ! pidof fm_transmitter >/dev/null 2>&1; then
      /usr/bin/radio-start-silence "$frequency" >/var/log/radio-auto-stream.log 2>&1 || true
    fi
  fi

  sleep 3
done
