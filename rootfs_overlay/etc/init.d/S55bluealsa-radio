#!/bin/sh

case "$1" in
  start)
    printf 'Starting BlueALSA A2DP sink: '
    bluealsa -p a2dp-sink >/var/log/bluealsa.log 2>&1 &
    echo "OK"
    ;;
  stop)
    printf 'Stopping BlueALSA: '
    killall bluealsa 2>/dev/null || true
    echo "OK"
    ;;
  restart|reload)
    "$0" stop
    "$0" start
    ;;
  *)
    echo "Usage: $0 {start|stop|restart}"
    exit 1
    ;;
esac

exit 0

