#!/bin/sh

case "$1" in
  start)
    printf 'Preparing FM stream: '
    printf '%s\n' "$(cat /tmp/radio-frequency 2>/dev/null || echo 108.0)" >/tmp/radio-frequency
    echo "OK"
    ;;
  stop)
    printf 'Stopping FM stream: '
    /usr/bin/radio-stop-stream
    echo "OK"
    ;;
  restart|reload)
    "$0" stop
    "$0" start
    ;;
  *)
    echo "Usage: $0 {start|stop|restart}"
    exit 1
    ;;
esac

exit 0
