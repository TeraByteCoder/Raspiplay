#!/bin/sh

case "$1" in
  start)
    printf 'Configuring Bluetooth radio sink: '
    rfkill unblock bluetooth 2>/dev/null || true
    hciconfig hci0 up 2>/dev/null || true
    hciconfig hci0 name "Radio-Sender" 2>/dev/null || true
    hciconfig hci0 piscan 2>/dev/null || true
    btmgmt power on >/dev/null 2>&1 || true
    btmgmt connectable on >/dev/null 2>&1 || true
    btmgmt bondable on >/dev/null 2>&1 || true
    btmgmt pairable on >/dev/null 2>&1 || true
    btmgmt discov on >/dev/null 2>&1 || true
    bt-agent --capability=NoInputNoOutput -p /etc/bluetooth/pin.conf >/var/log/radio-bt-agent.log 2>&1 &
    /usr/bin/radio-bt-trust >/var/log/radio-bt-trust.log 2>&1 &
    echo "OK"
    ;;
  stop)
    printf 'Stopping Bluetooth radio agent: '
    killall radio-bt-trust 2>/dev/null || true
    killall bt-agent 2>/dev/null || true
    echo "OK"
    ;;
  restart|reload)
    "$0" stop
    "$0" start
    ;;
  *)
    echo "Usage: $0 {start|stop|restart}"
    exit 1
    ;;
esac

exit 0
