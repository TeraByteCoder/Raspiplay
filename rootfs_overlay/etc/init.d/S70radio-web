#!/bin/sh

case "$1" in
  start)
    printf 'Starting radio web interface: '
    httpd -f -p 192.168.4.1:80 -h /www >/var/log/radio-httpd.log 2>&1 &
    echo "OK"
    ;;
  stop)
    printf 'Stopping radio web interface: '
    killall httpd 2>/dev/null || true
    echo "OK"
    ;;
  restart|reload)
    "$0" stop
    "$0" start
    ;;
  *)
    echo "Usage: $0 {start|stop|restart}"
    exit 1
    ;;
esac

exit 0

